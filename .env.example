# ── Jira ──────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=QA
JIRA_REQUEST_TIMEOUT=30

# ── Ollama (primary LLM) ──────────────────────────────
# Cloud: https://ollama.com  |  Local: http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=your-ollama-api-key



# ── Groq (fallback LLM) ───────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Swagger ───────────────────────────────────────────
SWAGGER_REQUEST_TIMEOUT=30
# Default Swagger/OpenAPI spec URL used when a request doesn't supply one (optional)
SWAGGER_URL=

# ── Mapping strategy ──────────────────────────────────
# Options: keyword | embedding | ollama | groq
MAPPING_TYPE=ollama
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_P=0.1

# ── Phase 3 output ────────────────────────────────────
OUTPUT_DIR=output
REPORTS_DIR=reports
API_BASE_URL=https://reqres.in/api
API_KEY_DEFAULT=

# ── GitHub automation PR (optional) ───────────────────
# PRs can be raised on demand from the dashboard ("Raise PR"), or
# automatically after a run via the "Create PR automatically after test run"
# toggle. Passing tests are never required. The PR scope dropdown picks what
# ships: all tests, only the tests that passed, or one PR per test (each on its
# own branch, in its own file, so they can be merged independently).
GITHUB_TOKEN=
GITHUB_AUTOMATION_REPO=owner/automation-repo
GITHUB_PR_BASE_BRANCH=main
# Prefix for auto-generated branch names (automation/<TICKET>). The dashboard
# can override the whole branch name per PR.
GITHUB_PR_BRANCH_PREFIX=automation
# Fallback directory for generated tests, used only when repo analysis is off
# (or finds no tests) and the UI supplies no path.
GITHUB_TESTS_PATH=tests
# Read the target repo before raising a PR — its test layout, naming, conftest
# fixtures and pytest config — so files land where its own tests already live.
GITHUB_ANALYZE_REPO=true
# Rewrite generated modules via Groq to reuse the target repo's fixtures,
# helpers and style. A rewrite that drops a test or its assertions is discarded
# and the file ships exactly as generated. Costs one Groq call per module.
GITHUB_ADAPT_TESTS=false
AUTO_CREATE_PR=false

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO

# ── FastAPI ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
