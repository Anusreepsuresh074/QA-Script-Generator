# --- Ollama (local LLM — primary) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=your-ollama-api-key

# --- Groq (cloud LLM — fallback) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Comma-separated channel IDs (e.g. C01234567,C07654321). Leave empty to allow all channels the bot is in.
SLACK_CHANNEL_IDS=

# --- Jira Cloud ---
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug
# Optional: default priority name as it appears in Jira (e.g. Medium, High)
JIRA_DEFAULT_PRIORITY=Medium
# JSON map: lowercase module/platform keyword -> Jira user email for assignee lookup
# Example: {"payments":"dev1@company.com","ios":"mobile@company.com"}
JIRA_MODULE_ASSIGNEE_MAP={}

# --- Duplicate detection ---
DUPLICATE_CACHE_TTL_SECONDS=86400
DUPLICATE_CACHE_MAX_ENTRIES=500

# --- App ---
LOG_LEVEL=INFO
# HTTP port when using: python run_dev.py (avoids typing --port each time)
APP_PORT=8080





